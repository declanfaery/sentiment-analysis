# Required for live X/Twitter collection.
X_BEARER_TOKEN=

# Conservative query length keeps the project usable across X API access tiers.
X_QUERY_MAX_CHARS=512
X_MAX_WORKERS=4

# Defaults used by the CLI when omitted.
MIN_MENTIONS=25
EARNINGS_HORIZON_DAYS=14

# Weekly earnings-options automation. Paper mode never sends broker orders.
TRADING_MODE=paper
TRADING_DB_PATH=data/scans.sqlite3
STRATEGY_NAME=main
# Leave blank for the primary account. A separate sleeve can set this to 10000.
STRATEGY_STARTING_CAPITAL=
# A separate sleeve can mirror this database instead of running another X scan.
AUTOMATION_SCAN_SOURCE_DB=
AUTOMATION_SCAN_OPTIONS=data/automation_scan_options.json
WEEKLY_SCAN_HOUR_ET=8
WEEKLY_SCAN_MINUTE_ET=0
EXIT_DELAY_MINUTES=15
ENTRY_BEFORE_CLOSE_MINUTES=15
WEEKLY_SCAN_RETRY_SECONDS=3600
TRADING_POLL_SECONDS=30

# Paper and portfolio risk limits.
PAPER_CASH_BALANCE=100000
BASE_ALLOCATION_PCT=0.05
CONFIRMED_ALLOCATION_PCT=0.07
MIN_TRADE_SCORE=25
REQUIRE_TRADE_CORROBORATION=true
# Keep this at 1 for cautious testing. A sandbox account can raise it so the
# allocation percentage, rather than this safety cap, determines quantity.
MAX_CONTRACTS_PER_TRADE=1
MAX_TOTAL_EXPOSURE_PCT=0.20
MAX_OPTION_SPREAD_PCT=0.12
OPTION_TARGET_ITM_PCT=0.10
OPTION_TARGET_DELTA=0.80
OPTION_MAX_OTM_PCT=0
AFFORDABLE_OPTION_FALLBACK=false
AFFORDABLE_FALLBACK_MAX_OTM_PCT=0.03
MAX_OPTION_BREAKEVEN_PCT=0.025
MIN_OPTION_VOLUME=0
MIN_OPTION_OPEN_INTEREST=100
MIN_EXPIRATION_DAYS_AFTER_EXIT=14
MAX_EXPIRATION_DAYS_AFTER_EXIT=28
EARLY_EXIT_MONITOR_MINUTES=15
EARLY_EXIT_PROFIT_PCT=0.05
EXIT_CHASE_STEP_PCT=0.10
ENTRY_WINDOW_MINUTES=14
REPRICE_AFTER_SECONDS=60
MAX_ENTRY_CHASE_PCT=0.03
ENTRY_CHASE_STEP_PCT=0.01

# Read-only forward research. It records hypothetical contracts and outcomes;
# it never submits, replaces, or cancels an order.
SHADOW_RESEARCH_ENABLED=false
SHADOW_MAX_TICKERS=8
SHADOW_ENTRY_MINUTES_BEFORE_CLOSE=60,30,15
SHADOW_TARGET_DELTAS=0.50,0.65,0.80
SHADOW_EXPIRATION_DAYS_AFTER_EXIT=7,14,21,28
SHADOW_OBSERVATION_MINUTES_AFTER_OPEN=0,5,15,30
SHADOW_ENTRY_GRACE_MINUTES=12
SHADOW_OBSERVATION_GRACE_MINUTES=4
SHADOW_MAX_QUOTE_AGE_SECONDS=180
SHADOW_MAX_SPREAD_PCT=0.30
SHADOW_MAX_OTM_PCT=0.05
SHADOW_MIN_OPEN_INTEREST=0

# Official Webull OpenAPI credentials. Sandbox and production keys are different.
WEBULL_SANDBOX_APP_KEY=
WEBULL_SANDBOX_APP_SECRET=
WEBULL_SANDBOX_ACCOUNT_ID=

WEBULL_LIVE_APP_KEY=
WEBULL_LIVE_APP_SECRET=
WEBULL_LIVE_ACCOUNT_ID=

# Live orders remain locked unless this exact value is set.
ENABLE_LIVE_TRADING=
